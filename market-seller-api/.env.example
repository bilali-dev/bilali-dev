REQUEST_TIMEOUT_SECONDS=30
USER_AGENT=Mozilla/5.0 (compatible; MarketSellerAPI/0.1; +https://example.com/bot)
MAX_BODY_SIZE_BYTES=1000000
RATE_LIMIT_PER_MINUTE=30

# sqlite:///./market_seller_api.db for local dev; postgresql+psycopg://user:pass@host:5432/db in production
DATABASE_URL=sqlite:///./market_seller_api.db

# Secret used to sign monitor webhook payloads (X-Signature-256 header)
WEBHOOK_SECRET=change-me

# Optional: leave empty to disable billing endpoints (they respond 501)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
