TELEGRAM_BOT_TOKEN=coloque_aqui_o_token_do_seu_bot

# ID do chat/usuario do Telegram que vai receber os alertas.
# Para descobrir o seu, fale com @userinfobot no Telegram.
TELEGRAM_CHAT_ID=

# Credenciais da SUA propria conta na VFS Global (nunca compartilhe este arquivo).
VFS_EMAIL=
VFS_PASSWORD=

# URLs especificas do seu pais/missao no portal da VFS Global.
# Exemplo (ajuste para o seu caso real):
# VFS_LOGIN_URL=https://visa.vfsglobal.com/xxx/en/yyy/login
# VFS_APPOINTMENT_URL=https://visa.vfsglobal.com/xxx/en/yyy/book-appointment
VFS_LOGIN_URL=
VFS_APPOINTMENT_URL=

# Intervalo entre checagens, em minutos. Recomendado: 10 ou mais,
# para nao sobrecarregar o site nem arriscar bloqueio da sua conta/IP.
VFS_CHECK_INTERVAL_MINUTES=15
