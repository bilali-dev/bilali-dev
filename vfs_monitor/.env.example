# Copia este ficheiro para ".env" e preenche com os teus dados.
# NUNCA faças commit do ficheiro ".env" real (já está no .gitignore).

# Credenciais da tua conta VFS Global
VFS_EMAIL=
VFS_PASSWORD=

# URL de login do portal (ajusta ao país/posto certo)
VFS_URL=https://visa.vfsglobal.com/gnb/pt/prt/login

# Texto da categoria de visto a monitorizar (case-insensitive)
VISA_CATEGORY_TEXT=schengen

# Bot do Telegram: cria um bot com @BotFather e obtém o token.
# Para obter o chat_id, envia uma mensagem ao bot e consulta:
# https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Intervalo entre verificações, em segundos (mínimo forçado: 180)
CHECK_INTERVAL_SECONDS=300

# Tempo mínimo entre alertas consecutivos, em segundos
ALERT_COOLDOWN_SECONDS=1800

# true para correr sem abrir janela do browser
HEADLESS=false
